# Optional — without these, PULSE runs fully in Demo Mode
# (in-memory ledger, canned reaction lines)

# Groq API key for AI-generated reaction lines
GROQ_API_KEY=

# Supabase project (server-side service role key, keep secret)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your Celo Agents at Work attribution tag (celo_...)
NEXT_PUBLIC_ATTRIBUTION_TAG=
